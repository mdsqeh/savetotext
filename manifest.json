{
  "manifest_version": 3,
  "version": "1.9.0",
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "default_locale": "zh_CN",
  "permissions": [
    "contextMenus",
    "downloads",
    "scripting",
    "activeTab",
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "savetotext@example.com",
      "strict_min_version": "142.0",
      "strict_min_android_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "随手记",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
